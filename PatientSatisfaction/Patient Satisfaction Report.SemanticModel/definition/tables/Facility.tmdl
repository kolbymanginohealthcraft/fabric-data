/// Unified facility dimension. Collapses the former Salesforce-shaped star
/// (Account + Chain + Aegis Contract + VW_NHAegisFacilities) into one table,
/// all derived from Silver dbo.facility + dbo.facilityhierarchy keyed on the
/// 5-digit FacilityNumber. LicenseNumber carries the CMS CCN, which replaces
/// the former Salesforce Account.CCN__c join to CustomerGroups.
table Facility
	lineageTag: a404d59b-a7a1-44f9-911b-d3f78d0a7e33

	measure 'Total Facilities' =
			
			CALCULATE(
			    DISTINCTCOUNT(Facility[BuildingKey]),
			    Facility[IsValid],
			    FILTER(
			        Facility,
			        [Total Respondents]>0 || [Total Planned Discharges]>0
			    )
			)
		formatString: 0
		lineageTag: 06c49250-9ced-4542-8d29-70e57f5d05a2

	measure 'Customer Name' =
			
			//if one facility is selected
			SELECTEDVALUE(Facility[Name],
			
			//if multiple facilities are selected
			IF(ISFILTERED(CustomerGroups[Customer Group]),SELECTEDVALUE(CustomerGroups[Customer Group]),
			IF(ISFILTERED(Facility[ChainName]),SELECTEDVALUE(Facility[ChainName]),
			IF(ISFILTERED(Facility[Region]),"Region "&SELECTEDVALUE(Facility[Region]),
			IF(ISFILTERED(Facility[District]),"District "&SELECTEDVALUE(Facility[District]),
			IF(ISFILTERED(Facility[Division]),SELECTEDVALUE(Facility[Division]),
			IF(ISFILTERED(Facility[State]),SELECTEDVALUE(Facility[State]),
			IF([Total Facilities]=[Total Facilities BM],"Aegis Therapies",
			"My Customers"
			))))))))
			
			//shows number of facilities if more than one are selected
			&IF([Total Facilities]>1," ("&[Total Facilities]&" facilities)")
		lineageTag: b040271e-6d87-4fab-b7cf-6a4847fb3277

	measure 'Total Facilities BM' =
			
			CALCULATE(
			    [Total Facilities],
			    ALL(Facility),
			    ALL(Surveys[SurveyID]),
			    ALL(vw_UpnFacilityAccess)
			)
		formatString: 0
		lineageTag: cf095cd1-b4c0-4eb4-b69f-65feff348c7d

	measure 'Report Title' = IF(SELECTEDVALUE(Facility[Division])="5500 (Direct Bill)","Client Satisfaction Report","Patient Satisfaction Report")
		lineageTag: b4175b02-072a-4dd2-9eb6-77a76274c3b7

	measure 'Total Facilities with AS' =
			
			CALCULATE(
			    [Total Facilities],
			    FILTER(
			        Facility,
			        ISBLANK([Advocacy Score])=FALSE()
			    )
			)
		formatString: #,0
		lineageTag: a58ad407-3304-4d93-b40d-92749a775539

	measure 'Total Facilities with NPS' =
			
			CALCULATE(
			    [Total Facilities],
			    FILTER(
			        Facility,
			        ISBLANK([Net Promoter Score])=FALSE() && [Total Responses NPS]>=[NPS Threshold]
			    )
			)
		formatString: #,0
		lineageTag: b52c8d89-e1bc-4abb-8acd-85a74708d12d

	measure '% Total Facilities with NPS' =
			
			DIVIDE(
			    [Total Facilities with NPS],
			    [Total Facilities]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 212fabd1-929b-4288-a3e3-8e3007a2606d

	measure 'Total Facilities Above Response Rate Baseline' =
			
			CALCULATE(
			    [Total Facilities],
			    FILTER(
			        Facility,
			        [Respondents per Planned Discharge]>=[Respondents per Planned Discharge Baseline]
			    )
			)
		formatString: 0
		lineageTag: afb1b1ec-f40b-483c-a7c4-95211825d87f

	measure '% Total Facilities Above Response Rate Baseline' =
			
			DIVIDE(
			    [Total Facilities Above Response Rate Baseline],
			    [Total Facilities]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 86fb2ae3-f2ad-493f-8854-f6145c711d99

	measure '% Total Facilities with AS' =
			
			DIVIDE(
			    [Total Facilities with AS],
			    [Total Facilities]
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: d507a5bf-c6a0-415a-b214-20efb095eee7

	column FacilityNumber
