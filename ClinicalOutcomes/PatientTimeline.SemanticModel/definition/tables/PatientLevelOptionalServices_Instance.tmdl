table PatientLevelOptionalServices_Instance
	lineageTag: e573f993-d4f5-4614-ab71-a1d1fc0aefa1

	column Resident_ID
		dataType: int64
		formatString: 0
		lineageTag: 07da1270-ca17-4862-bbca-6fef9f6dd46c
		summarizeBy: none
		sourceColumn: Resident_ID

		annotation SummarizationSetBy = Automatic

	column Service_ID
		dataType: int64
		formatString: 0
		lineageTag: 788d916a-1597-4717-b7d2-87838bac6ac1
		summarizeBy: none
		sourceColumn: Service_ID

		annotation SummarizationSetBy = Automatic

	column CreatedDate
		dataType: dateTime
		formatString: General Date
		lineageTag: e7c0caba-64b2-4e47-b906-97ddeb674c7a
		summarizeBy: none
		sourceColumn: CreatedDate

		annotation SummarizationSetBy = Automatic

	/// Minutes logged against the service. Always present in Bronze; surfaced 2026-07-27 for
	/// Total Care Through Transitions (therapy vs restorative vs restorative + skilled care).
	column Duration
		dataType: int64
		formatString: 0
		lineageTag: 3f2a9c14-7b6e-4d58-9a21-c05e8b47d9f0
		summarizeBy: sum
		sourceColumn: Duration

		annotation SummarizationSetBy = Automatic

	partition PatientLevelOptionalServices_Instance = m
		mode: import
		queryGroup: Patient
		source = ```
				let
				    //Bronze lands the NetHealth service GUID two ways: a 16-byte binary and the
				    //36-byte ASCII text of the GUID string. Instance flipped binary -> text on
				    //2026-06-01 while Service stayed mixed, so joining the raw Ids silently drops
				    //~98% of rows from that date forward (Category comes back blank and every PLOS
				    //measure reads near zero). Normalize both sides to a canonical GUID string.
				    GuidKey = (col as text) as text =>
				        "UPPER(CASE WHEN DATALENGTH(" & col & ") = 36 THEN CAST(" & col & " AS varchar(36))"
				        & " ELSE LEFT(CONVERT(varchar(32), " & col & ", 2), 8) + '-'"
				        & " + SUBSTRING(CONVERT(varchar(32), " & col & ", 2), 9, 4) + '-'"
				        & " + SUBSTRING(CONVERT(varchar(32), " & col & ", 2), 13, 4) + '-'"
				        & " + SUBSTRING(CONVERT(varchar(32), " & col & ", 2), 17, 4) + '-'"
				        & " + SUBSTRING(CONVERT(varchar(32), " & col & ", 2), 21, 12) END)",
				    SqlText =
				        "SELECT i.Resident_ID, s.Service_ID, i.CreatedDate, i.Duration"
				        & " FROM (SELECT Resident_ID, CreatedDate, Duration, " & GuidKey("Service_ID") & " AS GuidKey"
				        & " FROM PatientLevelOptionalServices.Instance) i"
				        & " LEFT JOIN (SELECT Service_ID, " & GuidKey("Id") & " AS GuidKey"
				        & " FROM PatientLevelOptionalServices.Service) s ON s.GuidKey = i.GuidKey",
				    Source = Value.NativeQuery(_NetHealthBronze, SqlText)
				in
				    Source
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

