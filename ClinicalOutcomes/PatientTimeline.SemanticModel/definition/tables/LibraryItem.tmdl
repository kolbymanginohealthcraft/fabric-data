/// Per-element dimension: LibraryItem_ID -> element VersionName (revision tag), for DISPLAY only.
/// Sourced from Bronze dbo.LibraryItem (was aegisdataprod NetHealthDocumentation.LibraryItem).
/// NOTE: OP/SNF cohorting is NO LONGER derived here. An element's VersionName is its own revision
/// lineage, not the library it belongs to (one library reuses elements tagged across many versions
/// -- Jaclyn Warshauer, 2026-06-24), so element-grain classification manufactured phantom
/// multi-library tracks. Care setting now comes from the track's authoritative Library_ID via the
/// Library dim (Library[LibraryGroup]); this table's old CASE-on-VersionName column was removed.
table LibraryItem
	lineageTag: 11b10000-0000-4000-8000-000000000001

	column LibraryItem_ID
		dataType: int64
		isKey
		formatString: 0
		lineageTag: 11b10000-0000-4000-8000-000000000002
		summarizeBy: none
		sourceColumn: LibraryItem_ID

		annotation SummarizationSetBy = Automatic

	column VersionName
		dataType: string
		lineageTag: 11b10000-0000-4000-8000-000000000003
		summarizeBy: none
		sourceColumn: VersionName

		annotation SummarizationSetBy = Automatic

	partition LibraryItem = m
		mode: import
		queryGroup: Outcomes
		source =
				let
				    Source = Value.NativeQuery(_NetHealthBronze, "SELECT LibraryItem_ID, VersionName FROM dbo.LibraryItem WHERE LibraryItem_ID IS NOT NULL")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

