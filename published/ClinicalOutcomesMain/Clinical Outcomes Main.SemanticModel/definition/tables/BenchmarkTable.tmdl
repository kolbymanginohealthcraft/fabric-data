table BenchmarkTable
	lineageTag: e6d019ee-864f-4148-8fe5-1ac63c8c1b50

	calculationGroup
		precedence: 2

		calculationItem Provider = SELECTEDMEASURE()

		calculationItem Benchmark = ```
				
				// Which benchmark convention this report follows is driven by 'Benchmark Mode'[Scope].
				// National   = the legacy Clinical convention: fixed Contract Rehab cohort,
				//              immune to facility selection (Clinical Outcomes, Ohana Villas Stroke).
				// Divisional = keeps the Division in scope (Clinical Outcomes Semantic, Total Care).
				
				VAR __Div = VALUES(VW_NHAegisFacilities[Department])
				RETURN
				IF(
				    SELECTEDVALUE('Benchmark Mode'[Scope], "Divisional") = "National",
				
				    CALCULATE(
				        SELECTEDMEASURE(),
				        ALLSELECTED(StayCases[PatientCase_ID]),
				        ALL(StayCases[PatientCase_ID]),
				        ALL(vw_UpnFacilityAccess),
				        ALL(Patients),
				        VW_NHAegisFacilities[Department]="All Other"
				    ),
				
				    CALCULATE(
				        SELECTEDMEASURE(),
				        REMOVEFILTERS('Aegis Contract'),
				        REMOVEFILTERS(StayCases[PatientCase_ID]),
				        REMOVEFILTERS(vw_UpnFacilityAccess),
				        REMOVEFILTERS(Perspectives),
				        REMOVEFILTERS(Employees),
				        REMOVEFILTERS(Patients),
				        KEEPFILTERS(__Div),
				        SWITCH(
				            TRUE(),
				            ISFILTERED('Override State'[BillingState]),
				                Account[BillingState] IN VALUES('Override State'[BillingState]),
				            TRUE()
				        ),
				        SWITCH(
				            TRUE(),
				            ISFILTERED('Override Type'[Type]),
				                Account[Type] IN VALUES('Override Type'[Type]),
				            TRUE()
				        ),
				        SWITCH(
				            TRUE(),
				            ISFILTERED('Override Chain'[Name]),
				                Chain[Name] IN VALUES('Override Chain'[Name]),
				            TRUE()
				        )
				    )
				)
				
				```

	column BenchmarkSetting
		dataType: string
		lineageTag: 4713524f-7a6e-4015-a19d-8082c4f04ab9
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

		annotation SummarizationSetBy = Automatic

	column Ordinal
		dataType: int64
		formatString: 0
		lineageTag: 6a799bb4-dc76-4a8f-9f9a-a7c6bb0c695b
		summarizeBy: sum
		sourceColumn: Ordinal

		annotation SummarizationSetBy = Automatic

