	column ICD
		dataType: string
		lineageTag: 460b117b-b77a-4d45-ba61-26179e9420ef
		summarizeBy: none
		sourceColumn: ICD

		annotation SummarizationSetBy = Automatic

	partition DiagnosisCode = m
		mode: import
		queryGroup: Diagnoses
		source =
				let
				    Source = Value.NativeQuery(_NetHealthBronze, "SELECT c.DiagnosisCode_ID, c.Code + ':' + CHAR(32) + c.Description AS L4, r.Code + ':' + CHAR(32) + r.Description AS L3, g.label AS L2, gp.label AS L1, REPLACE(c.Code, '.', '') AS ICD FROM dbo.DiagnosisCode c INNER JOIN (SELECT Code, MAX(DiagnosisCode_ID) AS id FROM dbo.DiagnosisCode WHERE ParentDiagnosisCode_ID IS NULL AND LEN(Code) = 3 GROUP BY Code) rk ON rk.Code = LEFT(c.Code, 3) INNER JOIN dbo.DiagnosisCode r ON r.DiagnosisCode_ID = rk.id INNER JOIN (SELECT k.DiagnosisCategory_ID, k.ParentDiagnosisCategory_ID,  (CASE WHEN CHARINDEX('(', k.Description) > 0 THEN REPLACE(SUBSTRING(k.Description, CHARINDEX('(', k.Description) + 1, 200), ')', '') ELSE 'U00-U49' END) + ':' + CHAR(32) + RTRIM(CASE WHEN CHARINDEX('(', k.Description) > 0 THEN LEFT(k.Description, CHARINDEX('(', k.Description) - 1) ELSE k.Description END) AS label FROM dbo.DiagnosisCategory k) g ON c.DiagnosisCategory_ID = g.DiagnosisCategory_ID INNER JOIN (SELECT k.DiagnosisCategory_ID,  (CASE WHEN CHARINDEX('(', k.Description) > 0 THEN REPLACE(SUBSTRING(k.Description, CHARINDEX('(', k.Description) + 1, 200), ')', '') ELSE 'U00-U49' END) + ':' + CHAR(32) + RTRIM(CASE WHEN CHARINDEX('(', k.Description) > 0 THEN LEFT(k.Description, CHARINDEX('(', k.Description) - 1) ELSE k.Description END) AS label FROM dbo.DiagnosisCategory k) gp ON g.ParentDiagnosisCategory_ID = gp.DiagnosisCategory_ID")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

