	partition Employees = m
		mode: import
		queryGroup: People
		source =
				let
				    Source = Value.NativeQuery(_NetHealthBronze, "SELECT [Person_ID], RTRIM(ISNULL([FirstName],'')) + CHAR(32) + RTRIM(ISNULL([LastName],'')) AS [Name], RTRIM(ISNULL([StaffTitle],'')) AS [StaffTitle], LEFT(RTRIM(ISNULL([FirstName],'')),1) + CHAR(32) + RTRIM(ISNULL([LastName],'')) AS [Short Name], ISNULL([IsInactive],0) AS [IsInactive], [SupervisorPerson_ID], [Taxonomy_ID] FROM dbo.[Person] WHERE Person_ID IS NOT NULL")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

