	partition PatientLevelOptionalServices_Instance = m
		mode: import
		queryGroup: Patient
		source =
				let
				    Source = Value.NativeQuery(_NetHealthBronze, "SELECT [Resident_ID], CASE WHEN DATALENGTH([Service_ID])=16 THEN SUBSTRING(CONVERT(varchar(32),[Service_ID],2),1,8)+'-'+SUBSTRING(CONVERT(varchar(32),[Service_ID],2),9,4)+'-'+SUBSTRING(CONVERT(varchar(32),[Service_ID],2),13,4)+'-'+SUBSTRING(CONVERT(varchar(32),[Service_ID],2),17,4)+'-'+SUBSTRING(CONVERT(varchar(32),[Service_ID],2),21,12) ELSE UPPER(CAST([Service_ID] AS varchar(36))) END AS [Service_ID], [CreatedDate] FROM PatientLevelOptionalServices.[Instance]")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

