	column CreatedDate
		dataType: dateTime
		formatString: General Date
		lineageTag: e7c0caba-64b2-4e47-b906-97ddeb674c7a
		summarizeBy: none
		sourceColumn: CreatedDate

		variation Variation
			isDefault
			relationship: 39a24c88-290c-40a0-875b-e1a0ed2e06d7
			defaultHierarchy: LocalDateTable_e9e917f2-5178-4525-99ea-dc96c0ad92c2.'Date Hierarchy'

